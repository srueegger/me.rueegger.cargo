<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="CargoFilePanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>

    <!-- Path bar -->
    <child>
      <object class="GtkBox" id="path_bar_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">0</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <style>
          <class name="linked"/>
        </style>

        <child>
          <object class="GtkButton" id="up_button">
            <property name="icon-name">go-up-symbolic</property>
            <property name="tooltip-text" translatable="yes">Go to parent directory</property>
          </object>
        </child>

        <child>
          <object class="GtkEntry" id="path_entry">
            <property name="hexpand">true</property>
            <property name="placeholder-text" translatable="yes">Enter path...</property>
          </object>
        </child>
      </object>
    </child>

    <!-- File list -->
    <child>
      <object class="GtkScrolledWindow" id="scrolled_window">
        <property name="vexpand">true</property>
        <property name="hexpand">true</property>
        <property name="hscrollbar-policy">automatic</property>
        <property name="vscrollbar-policy">automatic</property>

        <child>
          <object class="GtkColumnView" id="column_view">
            <property name="show-column-separators">true</property>
            <property name="show-row-separators">false</property>
            <property name="reorderable">false</property>

            <child>
              <object class="GtkColumnViewColumn" id="name_column">
                <property name="title" translatable="yes">Name</property>
                <property name="expand">true</property>
                <property name="resizable">true</property>
              </object>
            </child>

            <child>
              <object class="GtkColumnViewColumn" id="size_column">
                <property name="title" translatable="yes">Size</property>
                <property name="fixed-width">100</property>
                <property name="resizable">true</property>
              </object>
            </child>

            <child>
              <object class="GtkColumnViewColumn" id="modified_column">
                <property name="title" translatable="yes">Modified</property>
                <property name="fixed-width">160</property>
                <property name="resizable">true</property>
              </object>
            </child>

            <child>
              <object class="GtkColumnViewColumn" id="permissions_column">
                <property name="title" translatable="yes">Permissions</property>
                <property name="fixed-width">110</property>
                <property name="resizable">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Status bar -->
    <child>
      <object class="GtkLabel" id="status_label">
        <property name="xalign">0</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <property name="margin-top">2</property>
        <property name="margin-bottom">4</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
      </object>
    </child>
  </template>
</interface>
