<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>me.rueegger.cargo</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>

  <name>Cargo</name>
  <summary>Transfer files between local and remote locations</summary>

  <developer id="me.rueegger">
    <name>Samuel Rüegger</name>
  </developer>

  <description>
    <p>
      Cargo is a dual-pane file transfer application for GNOME.
      Connect to FTP, FTPS, and SFTP servers and transfer files
      with a visual progress queue. Manage your server connections
      with the built-in site manager.
    </p>
    <p>
      Features include synchronized directory navigation, a pausable
      transfer queue with individual controls, and SSH key authentication.
    </p>
  </description>

  <launchable type="desktop-id">me.rueegger.cargo.desktop</launchable>

  <url type="homepage">https://github.com/srueegger/cargo</url>
  <url type="bugtracker">https://github.com/srueegger/cargo/issues</url>
  <url type="vcs-browser">https://github.com/srueegger/cargo</url>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.7.0" date="2026-03-13">
      <description>
        <p>Store passwords securely in the system keyring via libsecret</p>
      </description>
    </release>
    <release version="0.6.3" date="2026-03-04">
      <description>
        <ul>
          <li>Fix progress bar not updating during file transfers</li>
        </ul>
      </description>
    </release>
    <release version="0.6.2" date="2026-03-04">
      <description>
        <ul>
          <li>Fix progress bar not updating during file transfers</li>
          <li>Prevent application from being killed during active transfers</li>
        </ul>
      </description>
    </release>
    <release version="0.6.1" date="2026-03-03">
      <description>
        <ul>
          <li>Fix memory leak causing OOM kills during large file transfers</li>
          <li>Throttle progress updates to reduce CPU and memory overhead</li>
          <li>Fix signal handler accumulation in progress indicator and transfer list</li>
          <li>Auto-clear completed transfers from queue</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-03-02">
      <description>
        <ul>
          <li>Double-click files to transfer them instantly</li>
          <li>Desktop notifications for completed and failed transfers</li>
          <li>Keyboard shortcuts dialog</li>
          <li>Nautilus-style circular progress indicator in the sidebar</li>
          <li>Sidebar context menu to edit, delete, or disconnect sites</li>
          <li>Connection error handling with user-visible messages</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-03-01">
      <description>
        <p>Add sidebar with quick-connect, refresh button, custom protocol icons, and reorganize codebase</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-03-01">
      <description>
        <p>Add right-click context menu for uploading and downloading files.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-03-01">
      <description>
        <p>Add file overwrite confirmation dialog with options to overwrite, skip, rename, or conditionally overwrite based on size or date.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-02-27">
      <description>
        <p>Add drag and drop file transfer between panels.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-02-23">
      <description>
        <p>Initial release with FTP, FTPS, and SFTP support.</p>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
