#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Cargo"
msgstr "Cargo"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid ""
"Cargo is a dual-pane file transfer application for GNOME. Connect to FTP, "
"FTPS, and SFTP servers and transfer files with a visual progress queue. "
"Manage your server connections with the built-in site manager."
msgstr ""
"Cargo is a dual-pane file transfer application for GNOME. Connect to FTP, "
"FTPS, and SFTP servers and transfer files with a visual progress queue. "
"Manage your server connections with the built-in site manager."

#: data/me.rueegger.cargo.metainfo.xml.in
msgid ""
"Features include synchronized directory navigation, a pausable transfer "
"queue with individual controls, and SSH key authentication."
msgstr ""
"Features include synchronized directory navigation, a pausable transfer "
"queue with individual controls, and SSH key authentication."

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Initial release with FTP, FTPS, and SFTP support."
msgstr "Initial release with FTP, FTPS, and SFTP support."

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Double-click files to transfer them instantly"
msgstr "Double-click files to transfer them instantly"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Desktop notifications for completed and failed transfers"
msgstr "Desktop notifications for completed and failed transfers"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Keyboard shortcuts dialog"
msgstr "Keyboard shortcuts dialog"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Nautilus-style circular progress indicator in the sidebar"
msgstr "Nautilus-style circular progress indicator in the sidebar"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Sidebar context menu to edit, delete, or disconnect sites"
msgstr "Sidebar context menu to edit, delete, or disconnect sites"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Connection error handling with user-visible messages"
msgstr "Connection error handling with user-visible messages"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Fix memory leak causing OOM kills during large file transfers"
msgstr "Fix memory leak causing OOM kills during large file transfers"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Throttle progress updates to reduce CPU and memory overhead"
msgstr "Throttle progress updates to reduce CPU and memory overhead"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Fix signal handler accumulation in progress indicator and transfer list"
msgstr "Fix signal handler accumulation in progress indicator and transfer list"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Auto-clear completed transfers from queue"
msgstr "Auto-clear completed transfers from queue"

