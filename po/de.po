#
# ── Metainfo ──────────────────────────────────────────────────
#

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Cargo"
msgstr "Cargo"

#: data/me.rueegger.cargo.metainfo.xml.in
msgid ""
"Cargo is a dual-pane file transfer application for GNOME. Connect to FTP, "
"FTPS, and SFTP servers and transfer files with a visual progress queue. "
"Manage your server connections with the built-in site manager."
msgstr ""
"Cargo ist eine Zwei-Fenster-Dateiübertragungsanwendung für GNOME. Verbinden "
"Sie sich mit FTP-, FTPS- und SFTP-Servern und übertragen Sie Dateien mit "
"einer visuellen Fortschrittsanzeige. Verwalten Sie Ihre Serververbindungen "
"mit der integrierten Seitenverwaltung."

#: data/me.rueegger.cargo.metainfo.xml.in
msgid ""
"Features include synchronized directory navigation, a pausable transfer "
"queue with individual controls, and SSH key authentication."
msgstr ""
"Zu den Funktionen gehören synchronisierte Verzeichnisnavigation, eine "
"pausierbare Übertragungswarteschlange mit individueller Steuerung und "
"SSH-Schlüssel-Authentifizierung."

#: data/me.rueegger.cargo.metainfo.xml.in
msgid "Initial release with FTP, FTPS, and SFTP support."
msgstr "Erstveröffentlichung mit FTP-, FTPS- und SFTP-Unterstützung."

